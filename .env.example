# Copy to .env for local development (never commit .env)

DEBUG=True
SECRET_KEY=change-me-for-local-only

# Database (local PostgreSQL)
DB_NAME=delivery_app
DB_USER=delivery_user
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Bootstrap admin (required for: python manage.py ensure_admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# CORS (comma-separated origins for production)
# CORS_ORIGINS=https://deliveryapp-mobile.vercel.app

# Email — compliance expiry reminders (Phase 4D)
# Heroku SendGrid example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=<SendGrid API key>
# DEFAULT_FROM_EMAIL=you@yourdomain.com
